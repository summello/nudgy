# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenRouter (powers AI reminder drafting and photo extraction)
OPENROUTER_API_KEY=your_openrouter_key

# Default reminder-drafting model (any OpenRouter model slug)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional: separate multimodal model for invoice photos.
# Must be vision-capable; defaults to OPENROUTER_MODEL when unset.
# Example: OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000